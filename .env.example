# ─────────────────────────────────────────────────────────────
# Gulf of Trump — environment variables
# Copy this file to `.env.local` and fill in what you need.
# Every variable is optional: with none set, the game runs as a guest
# with saves in the browser.
# ─────────────────────────────────────────────────────────────

# Supabase — turns on Google sign-in and cloud saves.
# Dashboard → Project Settings → API. The anon key is public by design;
# row-level security (supabase/migrations) protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the ChatGPT connection is stored (encrypted). Default: ~/.gulf-of-trump
# GOT_HOME=

# 1 = replace the game master with an instant offline mock. For working on
# the interface without spending your ChatGPT plan. Never for real games.
# GOT_MOCK_AI=1

# 1 = the public demo, as on the Vercel site: the offline game master only,
# ChatGPT sign-in off, open to any host. See docs/deploy.md.
# NEXT_PUBLIC_GOT_DEMO=1
